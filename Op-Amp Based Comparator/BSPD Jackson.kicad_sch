			)
			(justify left top)
		)
		(uuid "62105153-0acd-4dfa-9d9a-6594fd6843fb")
	)
	(text_box "Questions:\n- How do we know to use +/- in our current->voltage calculations?\n\n- I calculated for 5mA in the voltage divider in the current sensor, is that good?"
