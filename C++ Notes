Useful Math Functions:
need to include <cmath> by writing #include <cmath> 
int main() {

    double x = 3;
    double y = 4;
    double z;

    z = std::max(x, y); // z is now 4 because 4 is the maximum between the two numbers
    z = std::min(x, y); // z is now 3 because 3 is the minimum between the two numbers
    z = pow(2, 3); // z is now 8 because 2^3 = 8
    z = sqrt(16); // z is now 4
    z = abs(-5); // z is now 5 because abs() returns the absolute value of a number aka |-5|
    z = ceil(3.14); // z is now 4 because ceil() rounds up to the nearest integer
    z = floor(3.14); // z is now 3 because floor() rounds down to the nearest integer
}

