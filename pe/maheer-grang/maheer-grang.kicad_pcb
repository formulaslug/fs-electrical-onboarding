		(rev "${REVISION}")
		(company "Formula Slug")
		(comment 1 "${NAMES}")
		(comment 2 "${COMMENT1}")
		(comment 3 "${COMMENT2}")
	)
	(layers
		(0 "F.Cu" signal)
		(2 "B.Cu" signal)
		(9 "F.Adhes" user "F.Adhesive")
		(11 "B.Adhes" user "B.Adhesive")
		(13 "F.Paste" user)
		(15 "B.Paste" user)
